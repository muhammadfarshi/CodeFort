# =============================================================================
# CodeFort Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env
# =============================================================================

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database ---
DATABASE_URL=sqlite:///./codefort.db

# --- Redis (optional, for production queue) ---
REDIS_URL=redis://localhost:6379/0

# --- AI / XAI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Application ---
APP_NAME=CodeFort
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# --- Runtime Sandbox Canary Credentials (SECURITY.md §5) ---
# These are SYNTHETIC values used to detect credential exfiltration.
# They must NEVER map to real credentials.
CANARY_GITHUB_TOKEN=CODEFORT_CANARY_GH_TOKEN_DO_NOT_USE
CANARY_AWS_ACCESS_KEY=CODEFORT_CANARY_AWS_KEY_DO_NOT_USE
CANARY_AWS_SECRET_KEY=CODEFORT_CANARY_AWS_SECRET_DO_NOT_USE
CANARY_NPM_TOKEN=CODEFORT_CANARY_NPM_TOKEN_DO_NOT_USE

# --- Feature Flags ---
ENABLE_RUNTIME_SANDBOX=false
ENABLE_PREMIUM_FEATURES=false
